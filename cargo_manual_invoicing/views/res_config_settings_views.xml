<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_cargo_ai" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.cargo.ai</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Cargo AI" string="Cargo AI Assistant" name="cargo_manual_invoicing" groups="base.group_system">
                    <block title="AI Integration" name="ai_integration_setting_container">
                        <setting id="openai_api_key_setting" help="Provide your OpenAI API Key to power the Voice Assistant">
                            <field name="openai_api_key" password="True"/>
                        </setting>
                        <setting id="gemini_api_key_setting" help="Provide your Gemini API Key for text generation">
                            <field name="gemini_api_key" password="True"/>
                        </setting>
                        <setting id="groq_api_key_setting" help="Provide your Groq API Key for ultra-fast AI processing">
                            <field name="groq_api_key" password="True"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
